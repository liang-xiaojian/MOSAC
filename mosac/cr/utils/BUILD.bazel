mosac_cc_library(
    name = "code_interface",
    hdrs = ["code_interface.h"],
)

mosac_cc_library(
    name = "linear_code",
    hdrs = ["linear_code.h"],
    copts = AES_COPT_FLAGS,
    deps = [
        ":code_interface",
        "//mosac/ss:ss_type",
        "//mosac/utils:field",
        "//mosac/utils:vec_op",
        "@yacl//yacl/base:int128",
        "@yacl//yacl/crypto/tools:rp",
        "@yacl//yacl/utils:thread_pool",
    ] + select({
        "@platforms//cpu:aarch64": [
            "@com_github_dltcollab_sse2neon//:sse2neon",
        ],
        "//conditions:default": [],
    }),
)

